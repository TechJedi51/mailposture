# Copy to .env for local Compose use. In Dockhand, add these in the stack's
# environment-variable panel instead. Never commit the real .env file.

TZ=America/Los_Angeles

# Comma-separated domains.
MONITORED_DOMAINS=example.com,example.net

# Per-domain mappings use: domain=value|value;domain=value
DKIM_SELECTORS=example.com=selector1|selector2;example.net=google|s1
TLS_ENDPOINTS=example.com=mta-sts.example.com:443|mail.example.com:465;example.net=www.example.net:443

REPORT_DAYS=7
REFRESH_MINUTES=15
REQUEST_TIMEOUT_MS=8000

MONITORING_NETWORK=monitoring
PROXY_NETWORK=proxy

OPENSEARCH_ENABLED=true
OPENSEARCH_URL=http://parsedmarc-opensearch:9200
OPENSEARCH_INDEX=dmarc_aggregate*
OPENSEARCH_USERNAME=admin
OPENSEARCH_VERIFY_TLS=false

# Secret when OpenSearch is enabled: enter this in Dockhand as a secret variable.
OPENSEARCH_PASSWORD=replace-with-your-opensearch-admin-password
